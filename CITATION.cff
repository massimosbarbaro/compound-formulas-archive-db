license: MIT
date-released: "2001-02-16"
repository-code: "https://github.com/massimosbarbaro/compound-formulas-archive-db"
keywords:
  - "db"
  - "compound formulas"
  - "PVC"
  - "plastics"
  - "laboratory"
  - "legacy software"
